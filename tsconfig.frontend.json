{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "./public/js",
    "rootDir": "./public/ts",
    "strict": false,
    "skipLibCheck": true,
    "allowJs": true
  },
  "include": ["public/ts/**/*"]
}
